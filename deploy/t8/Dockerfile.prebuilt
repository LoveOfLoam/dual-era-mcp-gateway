# Offline-friendly T8 image: binaries are cross-compiled by scripts/t8.ps1.
# This avoids a Docker-build-time `go mod download` (the sandbox has no
# proxy.golang.org access).
FROM alpine:3.20
RUN adduser -D -H -u 65532 nonroot
COPY deploy/t8/bin/gateway /gateway
COPY deploy/t8/bin/legacy-mock /legacy-mock
COPY deploy/t8/bin/policy /policy
COPY deploy/t8/bin/rest-mock /rest-mock
COPY deploy/t8/bin/sse-shim /sse-shim
COPY config/policy.example.json /config/policy.example.json
USER nonroot:nonroot
ENTRYPOINT ["/gateway"]